{
  "name": "dota-ai-coach-launcher",
  "version": "0.1.0",
  "private": true,
  "description": "Coursework defense launcher for Dota AI Coach.",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist:unpacked": "electron-builder --dir",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "42.4.0",
    "electron-builder": "26.15.2"
  },
  "build": {
    "appId": "com.dotaai.coach.launcher",
    "productName": "Dota AI Coach Launcher",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../backend/dist/dota-ai-coach-backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../desktop-overlay/dist/win-unpacked",
        "to": "desktop-overlay",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../data/match_simulations/replay_gsi_like_match_8843382732_pl_20_30.jsonl",
        "to": "data/match_simulations/replay_gsi_like_match_8843382732_pl_20_30.jsonl"
      },
      {
        "from": "../../data/match_simulations/replay_gsi_like_match_8843471434_jugg_10_20.jsonl",
        "to": "data/match_simulations/replay_gsi_like_match_8843471434_jugg_10_20.jsonl"
      },
      {
        "from": "../../README.md",
        "to": "README.md"
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "Dota AI Coach Launcher-${version}-portable.${ext}"
    }
  }
}
